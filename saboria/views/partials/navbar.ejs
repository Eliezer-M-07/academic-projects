<header class="sticky top-0 z-50 border-b border-stone-100 bg-white shadow-sm">
  <div class="px-5 sm:px-8 lg:px-12">
    <nav class="mx-auto grid max-w-7xl grid-cols-[1fr_auto] items-center gap-3 py-3 sm:gap-5 lg:grid-cols-[1fr_auto_1fr]" aria-label="Navegação principal">

      <a href="/" class="flex shrink-0 items-center" aria-label="Saboria, início">
        <img src="/images/saboria-logo.webp" alt="Saboria" class="h-10 w-auto sm:h-12">
      </a>

      <div class="hidden items-center justify-self-center gap-8 text-sm font-bold text-stone-600 lg:flex">

        <a href="/" class="transition hover:text-emerald-700">
          Início
        </a>

        <a href="/recipes" class="transition hover:text-emerald-700">
          Explorar receitas
        </a>

      </div>

      <div class="hidden shrink-0 items-center justify-self-end gap-3 lg:flex">

        <% if (isLoggedIn) { %>

          <div class="relative group">

            <button type="button"
              class="flex items-center gap-2 rounded-full border border-stone-100 bg-white py-1.5 pl-1.5 pr-3 transition hover:border-emerald-200 hover:bg-emerald-50/50"
              aria-label="Abrir menu do usuário">

              <img src="<%= userPhoto || '/images/default-profile.webp' %>" alt="Foto de perfil"
                class="h-9 w-9 rounded-full border border-stone-100 object-cover">

              <span class="hidden max-w-28 truncate text-sm font-bold text-stone-800 sm:block">
                <%= username %>
              </span>

              <svg class="h-4 w-4 text-stone-500 transition group-hover:rotate-180" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">

                <path d="m6 9 6 6 6-6" />

              </svg>

            </button>

            <div
              class="invisible absolute right-0 top-full z-50 mt-3 w-52 translate-y-1 rounded-2xl border border-stone-100 bg-white p-2 opacity-0 shadow-xl shadow-stone-900/10 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">

              <a href="/profile"
                class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-stone-700 transition hover:bg-emerald-50 hover:text-emerald-800">

                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">

                  <circle cx="12" cy="8" r="4" />
                  <path d="M5 21a7 7 0 0 1 14 0" />

                </svg>

                Meu perfil
              </a>

              <div class="my-1 border-t border-stone-100"></div>

              <form action="/logout" method="POST">

                <button type="submit"
                  class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-red-600 transition hover:bg-red-50">

                  <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">

                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" x2="9" y1="12" y2="12" />

                  </svg>

                  Sair

                </button>

              </form>

            </div>

          </div>

          <% } else { %>

            <a href="/login" class="text-sm font-bold text-stone-700 transition hover:text-emerald-700">
              Entrar
            </a>

            <a href="/register"
              class="rounded-xl bg-emerald-700 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-800 sm:px-5">
              Criar conta
            </a>

            <% } %>

      </div>

      <details class="group relative justify-self-end lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-stone-200 bg-white text-stone-700 transition hover:border-emerald-300 hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-700 [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menu de navegação">
          <svg class="h-5 w-5 group-open:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="hidden h-5 w-5 group-open:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m18 6-12 12M6 6l12 12" />
          </svg>
        </summary>

        <div class="absolute right-0 top-full z-50 mt-3 w-[min(20rem,calc(100vw-2.5rem))] rounded-2xl border border-stone-100 bg-white p-2 shadow-xl shadow-stone-900/10">
          <div class="flex flex-col text-sm font-semibold text-stone-700">
            <a href="/" class="rounded-xl px-4 py-3 transition hover:bg-emerald-50 hover:text-emerald-800">
              Início
            </a>
            <a href="/recipes" class="rounded-xl px-4 py-3 transition hover:bg-emerald-50 hover:text-emerald-800">
              Explorar receitas
            </a>

            <div class="my-1 border-t border-stone-100"></div>

            <% if (isLoggedIn) { %>
              <a href="/profile" class="flex items-center gap-3 rounded-xl px-4 py-3 transition hover:bg-emerald-50 hover:text-emerald-800">
                <img src="<%= userPhoto || '/images/default-profile.webp' %>" alt=""
                  class="h-8 w-8 rounded-full border border-stone-100 object-cover">
                <span class="min-w-0 truncate">Meu perfil</span>
              </a>
              <form action="/logout" method="POST">
                <button type="submit" class="w-full rounded-xl px-4 py-3 text-left text-red-600 transition hover:bg-red-50">
                  Sair
                </button>
              </form>
            <% } else { %>
              <a href="/login" class="rounded-xl px-4 py-3 transition hover:bg-emerald-50 hover:text-emerald-800">
                Entrar
              </a>
              <a href="/register" class="mt-1 rounded-xl bg-emerald-700 px-4 py-3 text-center text-white transition hover:bg-emerald-800">
                Criar conta
              </a>
            <% } %>
          </div>
        </div>
      </details>

    </nav>

  </div>
</header>
