<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head', { pageTitle: 'Saboria | Meu perfil' }) %>

  <body class="bg-[#f4f4f1] font-[Nunito_Sans,sans-serif] text-stone-900 antialiased">
    <%- include('../partials/navbar') %>

      <main class="px-5 py-10 sm:px-8 lg:px-12 lg:py-14">
        <div class="mx-auto max-w-7xl">

          <% if (message) { %>
            <div id="toastMessage" class="fixed top-20 right-3 z-[100] w-[calc(100%-3rem)] max-w-sm
                      overflow-hidden rounded-2xl border border-emerald-100
                      bg-white shadow-xl shadow-stone-900/10
                      transition-all duration-500 opacity-100 translate-x-0" role="status">
              <div class="flex items-center gap-3 px-4 py-3">

                <div class="flex h-9 w-9 shrink-0 items-center justify-center
                                rounded-full bg-emerald-50">
                  <svg class="h-5 w-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                    stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>

                <div class="min-w-0 flex-1">
                  <p class="text-sm font-bold text-stone-900">
                    Tudo certo!
                  </p>

                  <p class="mt-0.5 text-xs leading-snug text-stone-500">
                    <%= message %>
                  </p>
                </div>

              </div>

              <div class="h-1 w-full bg-emerald-50">
                <div id="toastProgress" class="h-full w-full origin-left bg-emerald-600"></div>
              </div>
            </div>
            <% } %>

              <section class="mb-10">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-800">
                  Área do usuário
                </p>

                <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
                  Meu perfil
                </h1>

                <p class="mt-2 text-stone-600">
                  Gerencie suas informações e acompanhe suas receitas.
                </p>
              </section>

              <section class="mb-8 rounded-3xl bg-white p-6 shadow-sm sm:p-8">
                <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">

                  <div class="flex min-w-0 flex-col items-center gap-5 sm:flex-row">

                    <img src="<%= user.photo || '/images/default-profile.webp' %>" alt="Foto de perfil"
                      class="h-24 w-24 shrink-0 rounded shadow-lg bg-stone-100 object-cover">

                    <div class="min-w-0 text-center sm:text-left">
                      <h2 class="break-words text-2xl font-extrabold">
                        <%= user.name %>
                      </h2>

                      <p class="mt-1 break-all text-sm text-stone-500">
                        <%= user.email %>
                      </p>
                    </div>

                  </div>

                  <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                    <button type="button" id="openEditProfile"
                      class="inline-flex items-center justify-center rounded-lg border border-emerald-800 px-5 py-2.5 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50">
                      Editar perfil
                    </button>

                    <button type="button" id="openDeleteAccount"
                      class="inline-flex items-center justify-center rounded-lg border border-red-200 px-5 py-2.5 text-sm font-semibold text-red-700 transition hover:bg-red-50">
                      Excluir conta
                    </button>
                  </div>

                </div>
              </section>


              <section class="mb-12">
                <div class="flex items-center justify-between rounded-2xl bg-white px-6 py-5 shadow-sm sm:px-8">

                  <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50">
                      <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                        class="text-emerald-700">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
                        <path d="M8 7h8" />
                        <path d="M8 11h8" />
                      </svg>
                    </div>

                    <div>
                      <p class="font-bold text-stone-800">
                        Receitas publicadas
                      </p>
                      <p class="mt-0.5 text-sm text-stone-500">
                        Total de receitas que você compartilhou.
                      </p>
                    </div>
                  </div>

                  <span class="text-3xl font-extrabold tabular-nums text-emerald-800 sm:text-4xl">
                    <%= recipes.length %>
                  </span>

                </div>
              </section>


              <section>

                <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                  <div>
                    <h2 class="text-2xl font-extrabold">
                      Minhas receitas
                    </h2>

                    <p class="mt-1 text-sm text-stone-600">
                      Todas as receitas que você publicou.
                    </p>
                  </div>

                  <a href="/recipes/create"
                    class="inline-flex items-center justify-center rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-900">
                    <icon name="plus" size="sm" />
                    Nova receita
                  </a>

                </div>


                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

                  <% if (recipes.length> 0) { %>

                    <% recipes.forEach(recipe=> { %>

                      <div
                        class="group relative overflow-hidden rounded-3xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

                        <!-- Link que cobre o card inteiro -->
                        <a href="/recipes/<%= recipe.id %>" aria-label="Ver receita: <%= recipe.title %>"
                          class="absolute inset-0 z-10 rounded-3xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-700">
                        </a>

                        <!-- Imagem da receita -->
                        <div class="relative h-52 overflow-hidden bg-stone-100">

                          <% if (recipe.archive) { %>

                            <img src="<%= recipe.archive %>" alt="<%= recipe.title %>"
                              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">

                            <% } else { %>

                              <!-- Ícone quando não existe imagem -->
                              <div class="flex h-full w-full items-center justify-center bg-emerald-50">

                                <svg xmlns="http://www.w3.org/2000/svg" width="58" height="58" viewBox="0 0 24 24"
                                  fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"
                                  stroke-linejoin="round" class="text-emerald-700/60">

                                  <rect x="3" y="3" width="18" height="18" rx="3" />
                                  <circle cx="8.5" cy="8.5" r="1.5" />
                                  <path d="m21 15-5-5L5 21" />

                                </svg>

                              </div>

                              <% } %>

                        </div>

                        <!-- Informações da receita -->
                        <div class="p-5">

                          <% if (recipe.Category) { %>
                            <span
                              class="inline-block rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                              <%= recipe.Category.name %>
                            </span>
                            <% } %>

                              <h3 class="mt-3 text-lg font-extrabold text-stone-900 line-clamp-1">
                                <%= recipe.title %>
                              </h3>

                              <p class="mt-2 text-sm leading-relaxed text-stone-500 line-clamp-2">
                                <%= recipe.description %>
                              </p>

                              <!-- Ações da receita -->

                              <!-- Ações da receita -->
                              <div class="relative z-20 mt-5 flex items-center justify-end gap-2">

                                <!-- Editar -->
                                <a href="/recipes/edit/<%= recipe.id %>" aria-label="Editar receita"
                                  title="Editar receita"
                                  class="group/edit flex h-10 items-center gap-2 rounded-xl border border-emerald-100 bg-emerald-50 px-3 text-emerald-700 transition-all duration-200 hover:border-emerald-200 hover:bg-emerald-700 hover:text-white">

                                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                    stroke-linejoin="round">


                                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />

                                  </svg>

                                  <span class="text-xs font-bold">Editar</span>
                                </a>

                                <form action="/recipes/delete/<%= recipe.id %>" method="POST" class="contents"
                                  onsubmit="return false;">

                                  <button type="button" onclick="openDeleteRecipeModal(this)"
                                    aria-label="Excluir receita" title="Excluir receita"
                                    class="flex h-10 items-center gap-2 rounded-xl border border-red-100 bg-red-50 px-3 text-red-600 transition-all duration-200 hover:border-red-200 hover:bg-red-600 hover:text-white">

                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                                      fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                      stroke-linejoin="round">
                                      <path d="M3 6h18" />
                                      <path d="M8 6V4h8v2" />
                                      <path d="m19 6-1 14H6L5 6" />
                                      <path d="M10 11v5" />
                                      <path d="M14 11v5" />
                                    </svg>

                                    <span class="text-xs font-bold">Excluir</span>
                                  </button>
                                </form>

                              </div>


                        </div>

                      </div>

                      <% }) %>

                        <% } else { %>

                          <div
                            class="col-span-full flex flex-col items-center justify-center rounded-3xl border border-dashed border-stone-300 bg-white px-6 py-12 text-center">

                            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-50">

                              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                stroke-linejoin="round" class="text-emerald-700">

                                <path d="M3 3h18v18H3z" />
                                <path d="m8 12 3 3 5-6" />

                              </svg>

                            </div>

                            <h3 class="mt-4 text-lg font-bold text-stone-900">
                              Nenhuma receita publicada
                            </h3>

                            <p class="mt-2 text-sm text-stone-500">
                              Suas receitas aparecerão aqui quando você publicar a primeira.
                            </p>

                          </div>

                          <% } %>

                </div>


                <% if (totalPages> 1) { %>

                  <div class="mt-10 flex items-center justify-center gap-2">

                    <!-- Página anterior -->
                    <% if (currentPage> 1) { %>
                      <a href="/profile?page=<%= currentPage - 1 %>"
                        class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-stone-600 transition hover:border-emerald-700 hover:text-emerald-700">

                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m15 18-6-6 6-6" />
                        </svg>
                      </a>
                      <% } %>

                        <!-- Números das páginas -->
                        <% for (let page=1; page <=totalPages; page++) { %>

                          <a href="/profile?page=<%= page %>"
                            class="flex h-10 min-w-10 items-center justify-center rounded-xl px-3 text-sm font-bold transition
                                <%= currentPage === page
                                    ? 'bg-emerald-700 text-white shadow-sm'
                                    : 'border border-stone-200 bg-white text-stone-600 hover:border-emerald-700 hover:text-emerald-700' %>">

                            <%= page %>
                          </a>

                          <% } %>

                            <!-- Próxima página -->
                            <% if (currentPage < totalPages) { %>
                              <a href="/profile?page=<%= currentPage + 1 %>"
                                class="flex h-10 w-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-stone-600 transition hover:border-emerald-700 hover:text-emerald-700">

                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                  stroke-linejoin="round">
                                  <path d="m9 18 6-6-6-6" />
                                </svg>
                              </a>
                              <% } %>

                  </div>

                  <% } %>



              </section>
        </div>
      </main>

      <div id="editProfileModal" data-open="<%= openEditModal %>"
        class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-stone-950/50 px-4 py-8 backdrop-blur-sm">
        <div class="relative my-auto w-full max-w-lg rounded-3xl bg-white p-6 shadow-xl sm:p-8" role="dialog"
          aria-modal="true" aria-labelledby="editProfileTitle">

          <div class="mb-7 flex items-start justify-between">
            <div>
              <h2 id="editProfileTitle" class="text-2xl font-extrabold">
                Editar perfil
              </h2>
              <p class="mt-1 text-sm text-stone-500">
                Atualize suas informações pessoais.
              </p>
            </div>

            <button type="button" id="closeEditProfile" aria-label="Fechar formulário"
              class="rounded-lg p-2 text-stone-400 transition hover:bg-stone-100 hover:text-stone-700">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m18 6-12 12" />
                <path d="m6 6 12 12" />
              </svg>
            </button>
          </div>

          <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="space-y-5">
            <% if (errors.general) { %>
              <p class="text-red-500 text-sm mb-4">
                <%= errors.general %>
              </p>
              <% } %>
                <div>
                  <label for="name" class="mb-1.5 block text-sm font-semibold text-stone-700">
                    Nome
                  </label>

                  <input type="numbers" id="name" name="name" value="<%= values?.name ?? user.name %>" required
                    maxlength="100" class="w-full rounded-lg border px-4 py-3 text-sm outline-none transition
                <%= errors?.name
                  ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/15'
                  : 'border-stone-200 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/15' %>">

                  <% if (errors?.name) { %>
                    <p class="mt-1.5 text-xs text-red-600" role="alert">
                      <%= errors.name %>
                    </p>
                    <% } %>
                </div>



                <div>
                  <label for="email" class="mb-1.5 block text-sm font-semibold text-stone-700">
                    E-mail
                  </label>

                  <input type="email" id="email" name="email" value="<%= values?.email ?? user.email %>" required
                    maxlength="255" class="w-full rounded-lg border px-4 py-3 text-sm outline-none transition
                <%= errors?.email
                  ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/15'
                  : 'border-stone-200 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/15' %>">

                  <% if (errors?.email) { %>
                    <p class="mt-1.5 text-xs text-red-600" role="alert">
                      <%= errors.email %>
                    </p>
                    <% } %>
                </div>


                <div>
                  <label for="photo" class="mb-1.5 block text-sm font-semibold text-stone-700">
                    Foto de perfil
                  </label>

                  <input type="file" id="photo" name="photo" accept="image/png,image/jpeg,image/webp"
                    aria-invalid="<%= errors?.photo ? 'true' : 'false' %>"
                    aria-describedby="<%= errors?.photo ? 'photo-error' : '' %>"
                    class="w-full rounded-lg border <%= errors?.photo ? 'border-red-500' : 'border-stone-200' %> bg-white text-sm text-stone-600 file:mr-4 file:border-0 file:bg-emerald-50 file:px-4 file:py-3 file:font-semibold file:text-emerald-800 hover:file:bg-emerald-100">

                  <p class="mt-1.5 text-xs text-stone-400">
                    Selecione uma imagem para substituir sua foto atual.
                  </p>

                  <% if (errors?.photo) { %>
                    <p id="photo-error" class="mt-1.5 text-xs text-red-600" role="alert">
                      <%= errors.photo %>
                    </p>
                  <% } %>
                </div>

                <div class="flex flex-col-reverse gap-3 border-t border-stone-100 pt-5 sm:flex-row sm:justify-end">

                  <button type="button" id="cancelEditProfile"
                    class="rounded-lg border border-stone-200 px-5 py-3 text-sm font-semibold text-stone-600 transition hover:bg-stone-50">
                    Cancelar
                  </button>

                  <button type="submit"
                    class="rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-900">
                    Salvar alterações
                  </button>

                </div>

          </form>
        </div>
      </div>

      <div id="deleteAccountModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-950/50 px-4 py-8 backdrop-blur-sm">

        <div class="w-full max-w-md rounded-3xl bg-white p-6 shadow-xl sm:p-8" role="dialog" aria-modal="true"
          aria-labelledby="deleteAccountTitle">

          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-50">
              <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                class="text-red-600">
                <path d="M3 6h18" />
                <path d="M8 6V4h8v2" />
                <path d="m19 6-1 14H6L5 6" />
                <path d="M10 11v5" />
                <path d="M14 11v5" />
              </svg>
            </div>

            <div>
              <h2 id="deleteAccountTitle" class="text-xl font-extrabold">
                Excluir conta
              </h2>
              <p class="mt-1 text-sm text-stone-500">
                Esta ação é permanente.
              </p>
            </div>
          </div>

          <p class="text-sm leading-6 text-stone-600">
            Tem certeza de que deseja excluir sua conta? Seus dados e acesso à
            plataforma serão perdidos. Essa ação não poderá ser desfeita.
          </p>

          <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

            <button type="button" id="cancelDeleteAccount"
              class="rounded-lg border border-stone-200 px-5 py-3 text-sm font-semibold text-stone-600 transition hover:bg-stone-50">
              Cancelar
            </button>

            <form action="/profile/delete" method="POST">
              <button type="submit"
                class="w-full rounded-lg bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700">
                Sim, excluir minha conta
              </button>
            </form>

          </div>
        </div>
      </div>
      <div id="deleteRecipeModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-950/50 px-4 py-8 backdrop-blur-sm">

        <div class="w-full max-w-md rounded-3xl bg-white p-6 shadow-xl sm:p-8" role="dialog" aria-modal="true"
          aria-labelledby="deleteRecipeTitle">

          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-50">

              <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                class="text-red-600">

                <path d="M3 6h18" />
                <path d="M8 6V4h8v2" />
                <path d="m19 6-1 14H6L5 6" />
                <path d="M10 11v5" />
                <path d="M14 11v5" />
              </svg>

            </div>

            <div>
              <h2 id="deleteRecipeTitle" class="text-xl font-extrabold">
                Excluir receita
              </h2>

              <p class="mt-1 text-sm text-stone-500">
                Esta ação é permanente.
              </p>
            </div>
          </div>

          <p class="text-sm leading-6 text-stone-600">
            Tem certeza de que deseja excluir esta receita? A publicação e sua imagem
            serão removidas permanentemente. Essa ação não poderá ser desfeita.
          </p>

          <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

            <button type="button" id="cancelDeleteRecipe"
              class="rounded-lg border border-stone-200 px-5 py-3 text-sm font-semibold text-stone-600 transition hover:bg-stone-50">
              Cancelar
            </button>

            <button type="button" id="confirmDeleteRecipe"
              class="rounded-lg bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700">
              Sim, excluir receita
            </button>

          </div>
        </div>
      </div>
      <script>
        const toastMessage = document.getElementById('toastMessage');
        const toastProgress = document.getElementById('toastProgress');

        if (toastMessage) {
          toastProgress.style.transition = 'transform 3s linear';
          toastProgress.style.transform = 'scaleX(0)';

          setTimeout(() => {
            toastMessage.classList.add('opacity-0');

            setTimeout(() => {
              toastMessage.remove();
            }, 500);

          }, 3000);
        }

        const modal = document.getElementById('editProfileModal');
        const openButton = document.getElementById('openEditProfile');
        const closeButton = document.getElementById('closeEditProfile');
        const cancelButton = document.getElementById('cancelEditProfile');

        const deleteModal = document.getElementById('deleteAccountModal');
        const openDeleteButton = document.getElementById('openDeleteAccount');
        const cancelDeleteButton = document.getElementById('cancelDeleteAccount');


        function openModal() {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.classList.add('overflow-hidden');
        }

        function closeModal() {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.classList.remove('overflow-hidden');
        }

        openButton.addEventListener('click', openModal);
        closeButton.addEventListener('click', closeModal);
        cancelButton.addEventListener('click', closeModal);

        modal.addEventListener('click', (event) => {
          if (event.target === modal) {
            closeModal();
          }
        });


        function openDeleteModal() {
          deleteModal.classList.remove('hidden');
          deleteModal.classList.add('flex');
          document.body.classList.add('overflow-hidden');
        }

        function closeDeleteModal() {
          deleteModal.classList.add('hidden');
          deleteModal.classList.remove('flex');
          document.body.classList.remove('overflow-hidden');
        }

        openDeleteButton.addEventListener('click', openDeleteModal);
        cancelDeleteButton.addEventListener('click', closeDeleteModal);

        deleteModal.addEventListener('click', (event) => {
          if (event.target === deleteModal) {
            closeDeleteModal();
          }
        });


        const deleteRecipeModal = document.getElementById('deleteRecipeModal');
        const cancelDeleteRecipe = document.getElementById('cancelDeleteRecipe');
        const confirmDeleteRecipe = document.getElementById('confirmDeleteRecipe');

        let recipeFormToDelete = null;

        function openDeleteRecipeModal(button) {
          recipeFormToDelete = button.closest('form');

          deleteRecipeModal.classList.remove('hidden');
          deleteRecipeModal.classList.add('flex');
          document.body.classList.add('overflow-hidden');
        }

        function closeDeleteRecipeModal() {
          deleteRecipeModal.classList.add('hidden');
          deleteRecipeModal.classList.remove('flex');
          document.body.classList.remove('overflow-hidden');

          recipeFormToDelete = null;
        }

        cancelDeleteRecipe.addEventListener('click', closeDeleteRecipeModal);

        confirmDeleteRecipe.addEventListener('click', () => {
          if (recipeFormToDelete) {
            recipeFormToDelete.submit();
          }
        });

        deleteRecipeModal.addEventListener('click', (event) => {
          if (event.target === deleteRecipeModal) {
            closeDeleteRecipeModal();
          }
        });


        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            if (!deleteRecipeModal.classList.contains('hidden')) {
              closeDeleteRecipeModal();
            } else if (!deleteModal.classList.contains('hidden')) {
              closeDeleteModal();
            } else if (!modal.classList.contains('hidden')) {
              closeModal();
            }
          }
        });


        if (modal.dataset.open === 'true') {
          openModal();
        }
      </script>



