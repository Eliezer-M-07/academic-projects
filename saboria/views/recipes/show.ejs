
<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head', { pageTitle: `${recipe.title} | Saboria` }) %>

<body class="bg-[#f4f4f1] font-[Nunito_Sans,sans-serif] text-stone-900 antialiased">

    <%- include('../partials/navbar') %>

    <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 lg:py-14">

        <a href="/recipes"
            class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-stone-500 transition hover:text-emerald-800">

            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
            </svg>

            Voltar às receitas
        </a>

        <div class="overflow-hidden rounded-3xl bg-white shadow-sm">


            <div class="h-72 sm:h-96 lg:h-[480px]">
                <img
                    src="<%= recipe.archive %>"
                    alt="<%= recipe.title %>"
                    class="h-full w-full object-cover">
            </div>

            <div class="p-6 sm:p-10 lg:p-12">

                <span class="inline-flex rounded-full bg-emerald-50 px-4 py-2 text-xs font-bold uppercase tracking-wider text-emerald-800">
                    <%= recipe.Category ? recipe.Category.name : 'Sem categoria' %>
                </span>

                <h1 class="mt-5 text-3xl font-extrabold leading-tight tracking-tight text-stone-900 sm:text-4xl lg:text-5xl">
                    <%= recipe.title %>
                </h1>

                <div class="mt-6 flex items-center gap-3 border-b border-stone-100 pb-8">

                    <% if (recipe.User) { %>

                        <img
                            src="<%= recipe.User.photo %>"
                            alt="<%= recipe.User.name %>"
                            class="h-11 w-11 rounded-full object-cover">

                        <div>
                            <p class="text-xs text-stone-400">Publicado por</p>
                            <p class="text-sm font-bold text-stone-800">
                                <%= recipe.User.name %>
                            </p>
                        </div>

                    <% } else { %>

                        <div>
                            <p class="text-xs text-stone-400">Publicado por</p>
                            <p class="text-sm font-bold text-stone-800">
                                Usuário removido
                            </p>
                        </div>

                    <% } %>

                </div>

                <section class="mt-9">

                    <h2 class="text-xl font-extrabold text-stone-900">
                        Sobre a receita
                    </h2>

                    <p class="mt-4 whitespace-pre-line text-base leading-8 text-stone-600">
                        <%= recipe.description %>
                    </p>

                </section>
                
                <% if (isLoggedIn && Number(userId) === Number(recipe.user_id)) { %>

                    <div class="mt-10 flex flex-wrap gap-3 border-t border-stone-100 pt-8">

                        <a href="/recipes/edit/<%= recipe.id %>"
                            class="inline-flex items-center gap-2 rounded-xl border border-emerald-100 bg-emerald-50 px-5 py-3 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-100">

                            Editar receita
                        </a>

                        <a href="/profile"
                            class="inline-flex items-center gap-2 rounded-xl border border-stone-200 px-5 py-3 text-sm font-semibold text-stone-600 transition hover:bg-stone-50">

                            Meu perfil
                        </a>

                    </div>

                <% } %>

            </div>
        </div>

    </main>

    <%- include('../partials/footer') %>

</body>
</html>
