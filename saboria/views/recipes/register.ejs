
<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head', { pageTitle: 'Cadastrar receita | Saboria' }) %>

<body class="bg-[#f4f4f1] font-[Nunito_Sans,sans-serif] text-stone-900 antialiased">

    <%- include('../partials/navbar') %>

    <main class="mx-auto max-w-4xl px-5 py-10 sm:px-8 lg:py-14">

        <div class="mb-8">
            <a href="/profile"
                class="mb-5 inline-flex items-center gap-2 text-sm font-semibold text-stone-500 transition hover:text-emerald-800">

                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>

                Voltar ao perfil
            </a>

            <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
                Compartilhe sua receita
            </h1>

            <p class="mt-2 text-sm leading-6 text-stone-500">
                Conte para a comunidade como preparar sua receita favorita.
            </p>
        </div>

        <%- include('./partials/form', {
            recipe: null,
            categories,
            errors,
            values,
            formAction: '/recipes/create',
            buttonText: 'Publicar receita'
        }) %>

    </main>

    <%- include('../partials/footer') %>

</body>
</html>