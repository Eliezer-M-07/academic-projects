<article class="group relative overflow-hidden rounded-3xl border border-stone-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
  <a
    href="/recipes/<%= recipe.id %>"
    aria-label="Ver receita: <%= recipe.title %>"
    class="absolute inset-0 z-10 rounded-3xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-700">
  </a>

  <div class="relative h-56 overflow-hidden bg-stone-100">
    <% if (recipe.archive) { %>
      <img
        src="<%= recipe.archive %>"
        alt="<%= recipe.title %>"
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">
    <% } else { %>
      <div class="flex h-full w-full items-center justify-center bg-emerald-50">
        <svg xmlns="http://www.w3.org/2000/svg" width="58" height="58" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"
          class="text-emerald-700/50" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <path d="m21 15-5-5L5 21" />
        </svg>
      </div>
    <% } %>
  </div>

  <div class="p-5">
    <% if (recipe.Category) { %>
      <span class="inline-block rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
        <%= recipe.Category.name %>
      </span>
    <% } %>

    <h3 class="mt-3 line-clamp-1 text-xl font-extrabold text-stone-900 transition-colors group-hover:text-emerald-700">
      <%= recipe.title %>
    </h3>

    <p class="mt-2 line-clamp-2 min-h-10 text-sm leading-relaxed text-stone-500">
      <%= recipe.description %>
    </p>

    <div class="mt-5 flex items-center gap-3 border-t border-stone-100 pt-4">
      <% if (recipe.User && recipe.User.photo) { %>
        <img
          src="<%= recipe.User.photo %>"
          alt="<%= recipe.User.name %>"
          class="h-9 w-9 rounded-full border border-stone-100 object-cover">
      <% } else { %>
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="4" />
            <path d="M5 21a7 7 0 0 1 14 0" />
          </svg>
        </div>
      <% } %>

      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Publicado por</p>
        <p class="truncate text-sm font-bold text-stone-700">
          <%= recipe.User ? recipe.User.name : 'Usuário removido' %>
        </p>
      </div>

      <div class="ml-auto text-emerald-700 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </div>
    </div>
  </div>
</article>
