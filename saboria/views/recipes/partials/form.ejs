
<form action="<%= formAction %>" method="POST" enctype="multipart/form-data"
    class="overflow-hidden rounded-3xl border border-stone-100 bg-white shadow-sm">

    <div class="space-y-7 p-6 sm:p-9">

        <% if (errors?.general) { %>
            <div class="flex items-center gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3">
                <svg class="h-5 w-5 shrink-0 text-red-600" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                </svg>
                <p class="text-sm font-medium text-red-700">
                    <%= errors.general %>
                </p>
            </div>
        <% } %>

        <div>
            <label for="title" class="mb-2 block text-sm font-bold text-stone-800">
                Nome da receita
            </label>

            <input type="text" id="title" name="title"
                value="<%= values?.title ?? recipe?.title ?? '' %>"
                maxlength="150"
                placeholder="Ex.: Bolo de cenoura com chocolate"
                required
                class="w-full rounded-xl border <%= errors?.title ? 'border-red-400 bg-red-50/40 focus:border-red-500 focus:ring-red-500/15' : 'border-stone-200 bg-white focus:border-emerald-700 focus:ring-emerald-700/15' %> px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 focus:ring-2">

            <% if (errors?.title) { %>
                <p class="mt-2 text-xs font-medium text-red-600">
                    <%= errors.title %>
                </p>
            <% } %>
        </div>

        <div>
            <label for="category_id" class="mb-2 block text-sm font-bold text-stone-800">
                Categoria
            </label>

            <select id="category_id" name="category_id" required
                class="w-full rounded-xl border <%= errors?.category_id ? 'border-red-400 bg-red-50/40 focus:border-red-500 focus:ring-red-500/15' : 'border-stone-200 bg-white focus:border-emerald-700 focus:ring-emerald-700/15' %> px-4 py-3 text-sm text-stone-700 outline-none transition focus:ring-2">

                <option value="">Selecione uma categoria</option>

                <% categories.forEach(category => { %>
                    <option value="<%= category.id %>"
                        <%= String(values?.category_id ?? recipe?.category_id ?? '') === String(category.id) ? 'selected' : '' %>>
                        <%= category.name %>
                    </option>
                <% }) %>

            </select>

            <% if (errors?.category_id) { %>
                <p class="mt-2 text-xs font-medium text-red-600">
                    <%= errors.category_id %>
                </p>
            <% } %>
        </div>

        <div>
            <label for="description" class="mb-2 block text-sm font-bold text-stone-800">
                Modo de preparo e descrição
            </label>

            <textarea id="description" name="description" rows="7"
                placeholder="Conte os ingredientes e explique o passo a passo da preparação..."
                required
                class="w-full resize-y rounded-xl border <%= errors?.description ? 'border-red-400 bg-red-50/40 focus:border-red-500 focus:ring-red-500/15' : 'border-stone-200 bg-white focus:border-emerald-700 focus:ring-emerald-700/15' %> px-4 py-3 text-sm leading-6 outline-none transition placeholder:text-stone-400 focus:ring-2"><%= values?.description ?? recipe?.description ?? '' %></textarea>

            <% if (errors?.description) { %>
                <p class="mt-2 text-xs font-medium text-red-600">
                    <%= errors.description %>
                </p>
            <% } %>
        </div>

        <div>
            <label class="mb-2 block text-sm font-bold text-stone-800">
                Foto da receita
            </label>

            <% if (recipe?.archive) { %>
                <div class="mb-4">
                    <p class="mb-2 text-sm font-medium text-stone-600">
                        Imagem atual
                    </p>

                    <img src="<%= recipe.archive %>"
                        alt="Imagem atual da receita"
                        class="h-48 w-full rounded-2xl object-cover">
                </div>
            <% } %>

            <label for="archive"
                class="group flex min-h-56 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed <%= errors?.archive ? 'border-red-400 bg-red-50/50 hover:border-red-500 hover:bg-red-50' : 'border-stone-300 bg-stone-50 hover:border-emerald-600 hover:bg-emerald-50/50' %> px-6 py-8 text-center transition">

                <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700 transition group-hover:scale-105">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7"
                        fill="none" viewBox="0 0 24 24"
                        stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3 16.5V19a2 2 0 002 2h14a2 2 0 002-2v-2.5M16 8l-4-4m0 0L8 8m4-4v12" />
                    </svg>
                </div>

                <p class="font-bold text-stone-800">
                    <%= recipe ? 'Escolha uma nova foto para sua receita' : 'Escolha uma foto para sua receita' %>
                </p>

                <p class="mt-1 text-sm text-stone-500">
                    Clique aqui para selecionar uma imagem
                </p>

                <span class="mt-4 rounded-xl bg-emerald-700 px-5 py-2.5 text-sm font-bold text-white transition group-hover:bg-emerald-800">
                    Selecionar imagem
                </span>

                <p id="fileName" class="mt-3 text-xs text-stone-500">
                    PNG, JPG ou WEBP
                </p>

                <input type="file" id="archive" name="archive"
                    accept="image/png,image/jpeg,image/webp"
                    <%= recipe ? '' : 'required' %>
                    class="sr-only">
            </label>

            <% if (errors?.archive) { %>
                <p class="mt-2 text-sm text-red-600">
                    <%= errors.archive %>
                </p>
            <% } %>
        </div>

    </div>

    <div class="flex flex-col-reverse gap-3 border-t border-stone-100 bg-stone-50/70 px-6 py-5 sm:flex-row sm:justify-end sm:px-9">

        <a href="/profile"
            class="rounded-xl border border-stone-200 bg-white px-6 py-3 text-center text-sm font-semibold text-stone-600 transition hover:bg-stone-100">
            Cancelar
        </a>

        <button type="submit"
            class="rounded-xl bg-emerald-800 px-7 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-900 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:ring-offset-2">
            <%= buttonText %>
        </button>

    </div>

</form>

<script>
    const archiveInput = document.getElementById('archive');
    const fileName = document.getElementById('fileName');

    archiveInput.addEventListener('change', () => {
        if (archiveInput.files.length > 0) {
            fileName.textContent = archiveInput.files[0].name;
            fileName.classList.remove('text-stone-500');
            fileName.classList.add('font-semibold', 'text-emerald-700');
        } else {
            fileName.textContent = 'PNG, JPG ou WEBP';
        }
    });
</script>
