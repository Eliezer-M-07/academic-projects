
<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head', { pageTitle: 'Criar conta | Saboria'}) %>

<body class="bg-white font-[Nunito_Sans,sans-serif] text-stone-900 antialiased">
  <%- include('../partials/navbar') %>

  <main class="min-h-[calc(100vh-4rem)] lg:min-h-[calc(100vh-4.5625rem)]">
    <div class="grid min-h-[calc(100vh-4rem)] w-full bg-white lg:min-h-[calc(100vh-4.5625rem)] lg:grid-cols-2">

      <section class="flex items-center justify-center px-6 py-10 sm:px-12 lg:px-16 lg:py-0" aria-label="Formulário de cadastro">
        <div class="w-full max-w-sm">

          <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
            Crie sua conta
          </h1>

          <p class="mt-1 text-sm leading-6 text-stone-500">
            Cadastre-se para publicar receitas e consultar as de outros usuários.
          </p>
          <form action="/register" method="POST" enctype="multipart/form-data" class="mt-4 space-y-4 lg:mt-6 lg:space-y-3">
              <% if (errors.general) { %>
                <p class="text-red-500 text-sm mb-4">
                  <%= errors.general %>
                </p>
              <% } %>
              <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-stone-800">
                  Nome completo <span class="text-emerald-800">*</span>
                </label>

                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder="Seu nome"
                  value="<%= values.name || '' %>"
                  required
                  aria-invalid="<%= errors.name ? 'true' : 'false' %>"
                  aria-describedby="<%= errors.name ? 'name-error' : '' %>"
                  class="w-full rounded-lg border bg-white px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 lg:py-2
                  <%= errors.name
                    ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/15'
                    : 'border-stone-200 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/15' %>"
                >

                <% if (errors.name) { %>
                  <p id="name-error" class="mt-1.5 text-xs text-red-600" role="alert">
                    <%= errors.name %>
                  </p>
                <% } %>
              </div>

              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-stone-800">
                  E-mail <span class="text-emerald-800">*</span>
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="voce@exemplo.com"
                  value="<%= values.email || '' %>"
                  required
                  aria-invalid="<%= errors.email ? 'true' : 'false' %>"
                  aria-describedby="<%= errors.email ? 'email-error' : '' %>"
                  class="w-full rounded-lg border bg-white px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 lg:py-2
                  <%= errors.email
                    ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/15'
                    : 'border-stone-200 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/15' %>"
                >

                <% if (errors.email) { %>
                  <p id="email-error" class="mt-1.5 text-xs text-red-600" role="alert">
                    <%= errors.email %>
                  </p>
                <% } %>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">

                <div>
                  <label for="password" class="mb-1.5 block text-sm font-medium text-stone-800">
                    Senha <span class="text-emerald-800">*</span>
                  </label>

                  <input
                    id="password"
                    name="password"
                    type="password"
                    autocomplete="new-password"
                    placeholder="Crie uma senha"
                    required
                    aria-invalid="<%= errors.password ? 'true' : 'false' %>"
                    aria-describedby="<%= errors.password ? 'password-error' : '' %>"
                    class="w-full rounded-lg border bg-white px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 lg:py-2
                    <%= errors.password
                      ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/15'
                      : 'border-stone-200 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/15' %>"
                  >

                  <% if (errors.password) { %>
                    <p id="password-error" class="mt-1.5 text-xs text-red-600" role="alert">
                      <%= errors.password %>
                    </p>
                  <% } %>
                </div>

                <div>
                  <label for="password-confirm" class="mb-1.5 block text-sm font-medium text-stone-800">
                    Confirmar senha <span class="text-emerald-800">*</span>
                  </label>

                  <input
                    id="password-confirm"
                    name="passwordConfirm"
                    type="password"
                    autocomplete="new-password"
                    placeholder="Repita a senha"
                    required
                    aria-invalid="<%= errors.passwordConfirm ? 'true' : 'false' %>"
                    aria-describedby="<%= errors.passwordConfirm ? 'password-confirm-error' : '' %>"
                    class="w-full rounded-lg border bg-white px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 lg:py-2
                    <%= errors.passwordConfirm
                      ? 'border-red-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/15'
                      : 'border-stone-200 focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/15' %>"
                  >

                  <% if (errors.passwordConfirm) { %>
                    <p id="password-confirm-error" class="mt-1.5 text-xs text-red-600" role="alert">
                      <%= errors.passwordConfirm %>
                    </p>
                  <% } %>
                </div>

              </div>

              <p class="text-xs leading-5 text-stone-500">
                Use pelo menos 8 caracteres.
              </p>
              
              <div>
                <label for="photo" class="mb-1.5 block text-sm font-medium text-stone-800">
                  Foto de perfil <span class="font-normal text-stone-400">(opcional)</span>
                </label>

                <input
                  id="photo"
                  name="photo"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  aria-invalid="<%= errors.photo ? 'true' : 'false' %>"
                  aria-describedby="<%= errors.photo ? 'photo-error' : '' %>"
                  class="block w-full rounded-lg border <%= errors.photo ? 'border-red-500' : 'border-stone-200' %> bg-white text-sm text-stone-600 file:mr-4 file:border-0 file:bg-emerald-50 file:px-4 file:py-3 file:font-semibold file:text-emerald-800 hover:file:bg-emerald-100 lg:file:py-2"
                >

                <p class="mt-1.5 text-xs text-stone-400">
                  JPG, PNG ou WEBP. Tamanho máximo de 5 MB.
                </p>

                <% if (errors.photo) { %>
                  <p id="photo-error" class="mt-1.5 text-xs text-red-600" role="alert">
                    <%= errors.photo %>
                  </p>
                <% } %>
              </div>

              <button
                type="submit"
                class="w-full rounded-lg bg-emerald-800 px-5 py-3.5 text-sm font-semibold text-white transition hover:bg-emerald-900 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:ring-offset-2 lg:py-2.5"
              >
                Criar conta
              </button>

          </form>


          <p class="mt-6 text-center text-sm text-stone-500 lg:mt-3">
            Já tem uma conta?
            <a href="/login" class="font-semibold text-emerald-800 underline-offset-4 hover:underline">
              Entrar
            </a>
          </p>

        </div>
      </section>

      <section class="relative hidden overflow-hidden bg-emerald-900 lg:block lg:min-h-[calc(100vh-4.5625rem)]" aria-label="Foto de alimentos">
        <img
          src="/images/register-food.webp"
          alt="Molho sendo servido sobre um prato de frango com vegetais"
          class="absolute inset-0 h-full w-full object-cover object-center"
        >
      </section>

    </div>
  </main>
</body>
</html>
